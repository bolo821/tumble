+/* tracker_ensure_prev -- grow t->prev to hold at least `need` elements.
+ * Tracks allocated capacity in t->prev_cap separately from t->prev_count.
+ * Returns 1 on success, 0 on allocation failure. */
+static int tracker_ensure_prev(tmb_contact_tracker *t, size_t need)
+{
+    if (need <= t->prev_cap)
+        return 1;
+    size_t cap = t->prev_cap ? t->prev_cap * 2 : 64;
+    while (cap < need)
+        cap *= 2;
+    uint64_t *np = (uint64_t *)realloc(t->prev, cap * sizeof(uint64_t));
+    if (!np)
+        return 0;
+    t->prev     = np;
+    t->prev_cap = cap;
+    return 1;
