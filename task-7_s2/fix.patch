+/* tracker_sort_unique -- sort arr in place and deduplicate, updating *count. */
+static void tracker_sort_unique(uint64_t *arr, size_t *count)
+{
+    if (*count == 0)
+        return;
+    qsort(arr, *count, sizeof(uint64_t), cmp_u64);
+    size_t uniq = 0;
+    for (size_t i = 0; i < *count; i++) {
+        if (i == 0 || arr[i] != arr[i - 1])
+            arr[uniq++] = arr[i];
+    }
+    *count = uniq;
