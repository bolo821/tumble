+int tmb_contact_tracker_has_contact(const tmb_contact_tracker *t,
+                                    uint32_t a, uint32_t b)
+{
+    if (!t->prev || t->prev_count == 0)
+        return 0;
+    uint64_t key = ((uint64_t)(a < b ? a : b) << 32) |
+                   (uint64_t)(a < b ? b : a);
+    size_t lo = 0, hi = t->prev_count;
+    while (lo < hi) {
+        size_t mid = lo + (hi - lo) / 2;
+        if (t->prev[mid] == key)
+            return 1;
+        if (t->prev[mid] < key)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    return 0;
