+/* ---------------------------------------------------------------------------
+ * island_rec_alloc / island_rec_check
+ *
+ * These two helpers centralise every aspect of record construction and
+ * validation so that callers (the sleep-island builder in tmb_sleep_update
+ * and the on-remove repair path in tmb_sleep_on_remove) never have to
+ * reproduce the allocation arithmetic themselves.
+ * --------------------------------------------------------------------------- */
+
+/* Allocate and initialise a fresh island record sized for exactly `count`
+ * member slots.  Every index the caller writes via rec->members[rec->count++]
+ * is guaranteed to be within the allocation so long as rec->count does not
+ * exceed rec->alloc.  Returns NULL on any allocation failure or if count is
+ * non-positive. */
+static tmb_island_rec *island_rec_alloc(int count)
+{
+    if (count <= 0)
+        return NULL;
+    tmb_island_rec *rec = (tmb_island_rec *)malloc(sizeof(*rec));
+    if (!rec)
+        return NULL;
+    rec->members = (uint32_t *)malloc(sizeof(uint32_t) * (size_t)count);
+    if (!rec->members) {
+        free(rec);
+        return NULL;
+    }
+    rec->alloc = count; /* number of slots available in members[] */
+    rec->count = 0;     /* number of slots currently used */
+    return rec;
+}
+
+/* Validate structural invariants for an island record.
+ *
+ * Returns 1 (well-formed) when all of the following hold:
+ *   - r is non-NULL
+ *   - r->count is in [0, r->alloc]
+ *   - r->alloc is positive
+ *   - r->members is non-NULL (required when alloc > 0)
+ *
+ * Returns 0 on any violation. */
+static int island_rec_check(const tmb_island_rec *r)
+{
+    if (!r)
+        return 0;
+    if (r->alloc <= 0)
+        return 0;
+    if (r->count < 0)
+        return 0;
+    if (r->count > r->alloc)
+        return 0;
+    if (!r->members)
+        return 0;
+    return 1;
+}
+
