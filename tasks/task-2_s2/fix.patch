     if (w->body_count > 0) {
diff --git a/tests/test_joint_removal.c b/tests/test_joint_removal.c
new file mode 100644
index 0000000..ec47d8d
--- /dev/null
+++ b/tests/test_joint_removal.c
@@ -0,0 +1,279 @@
+/* Regression tests for joint and xjoint endpoint consistency after body removal.
+ *
+ * Core scenario: add bodies, wire them with a joint or xjoint, then remove
+ * one of the bodies.  The joint subsystem must either remove the joint
+ * (endpoint gone) or update its indices (endpoint moved by swap-pop), so
+ * that a subsequent world step does not access out-of-bounds body memory.
+ *
+ * All tests run under ASan (-fsanitize=address) so any stale index access
+ * is caught as a heap-buffer-overflow. */
+
+#include "tumble/tumble.h"
+#include "tumble/joints_ext.h"
+#include "tumble/solver.h"
+
+#include "tttest.h"
+#include <string.h>
+
+/* ---- helpers ---- */
+
+static tmb_world make_world(void)
+{
+    tmb_world w;
+    tmb_world_init(&w);
+    w.gravity = tmb_v2(0.0f, -10.0f);
+    return w;
+}
+
+static uint32_t add_box(tmb_world *w, float x, float y)
+{
+    tmb_body b;
+    tmb_body_init(&b, TMB_BODY_DYNAMIC, tmb_shape_box(0.5f, 0.5f), tmb_v2(x, y));
+    return tmb_world_add_body(w, &b);
+}
+
+static uint32_t add_floor(tmb_world *w)
+{
+    tmb_body f;
+    tmb_body_init(&f, TMB_BODY_STATIC, tmb_shape_box(20.0f, 1.0f), tmb_v2(0, -5));
+    return tmb_world_add_body(w, &f);
+}
+
+static void step_n(tmb_world *w, int n)
+{
+    for (int i = 0; i < n; i++)
+        tmb_world_step(w, 1.0f / 60.0f);
+}
+
+static int xj_validate(const tmb_world *w)
+{
+    char msg[256];
+    int rc = tmb_xjoints_validate(w, msg, sizeof(msg));
+    if (rc != 0)
+        fprintf(stderr, "  xjoint validate: %s\n", msg);
+    return rc;
+}
+
+static int j_validate(const tmb_world *w)
+{
+    char msg[256];
+    int rc = tmb_joints_validate(w, msg, sizeof(msg));
+    if (rc != 0)
+        fprintf(stderr, "  joint validate: %s\n", msg);
+    return rc;
+}
+
+/* ---- xjoint tests ---- */
+
+/* Remove one endpoint of a weld xjoint: the xjoint should be evicted. */
+static int test_xjoint_remove_endpoint(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t a = add_box(&w, -0.5f, 1.0f);
+    uint32_t b = add_box(&w,  0.5f, 1.0f);
+
+    tmb_xjoint xj;
+    tmb_xjoint_weld(&xj, a, b);
+    tmb_world_add_xjoint(&w, &xj);
+    CHECK(w.xjoint_count == 1);
+
+    /* Remove body a: the xjoint has a==a so it should be evicted. */
+    tmb_world_remove_body(&w, a);
+    CHECK(w.xjoint_count == 0);
+    CHECK(xj_validate(&w) == 0);
+
+    step_n(&w, 10);
+    CHECK(xj_validate(&w) == 0);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Remove the body that moved via swap-pop: xjoint endpoint must be remapped. */
+static int test_xjoint_remap_moved_endpoint(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t a = add_box(&w, -0.5f, 1.0f);  /* body 1 */
+    uint32_t b = add_box(&w,  0.5f, 1.0f);  /* body 2 */
+    uint32_t c = add_box(&w,  0.0f, 2.2f);  /* body 3 */
+
+    /* Weld a and c: indices 1 and 3. */
+    tmb_xjoint xj;
+    tmb_xjoint_weld(&xj, a, c);
+    tmb_world_add_xjoint(&w, &xj);
+    CHECK(w.xjoint_count == 1);
+
+    /* Remove body b (index 2); c (index 3 = last) moves to slot 2.
+     * The xjoint's j->b=3 must be patched to 2. */
+    tmb_world_remove_body(&w, b);
+    CHECK(w.xjoint_count == 1);
+    CHECK(xj_validate(&w) == 0);
+
+    /* One step must not overflow: xjoint_prepare accesses bodies[j->a] and
+     * bodies[j->b].  If the index was not patched, j->b=3 >= body_count=3
+     * and ASan would catch the out-of-bounds read. */
+    step_n(&w, 5);
+    CHECK(xj_validate(&w) == 0);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Multi-step: add/remove bodies with an xjoint across several rounds. */
+static int test_xjoint_multi_remove(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t ids[4];
+    for (int k = 0; k < 4; k++)
+        ids[k] = add_box(&w, (float)k - 1.5f, 2.0f);
+
+    /* Wire consecutive pairs. */
+    for (int k = 0; k + 1 < 4; k++) {
+        tmb_xjoint xj;
+        tmb_xjoint_weld(&xj, ids[k], ids[k + 1]);
+        tmb_world_add_xjoint(&w, &xj);
+    }
+    CHECK(w.xjoint_count == 3);
+
+    step_n(&w, 5);
+    CHECK(xj_validate(&w) == 0);
+
+    /* Remove bodies one at a time and check after each removal. */
+    while (tmb_world_body_count(&w) > 2) {
+        tmb_world_remove_body(&w, 1);
+        CHECK(xj_validate(&w) == 0);
+        step_n(&w, 2);
+    }
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* ---- regular joint tests ---- */
+
+/* Remove one endpoint of a distance joint: joint must be evicted. */
+static int test_joint_remove_endpoint(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t a = add_box(&w, -0.5f, 3.0f);
+    uint32_t b = add_box(&w,  0.5f, 3.0f);
+
+    tmb_joint j;
+    memset(&j, 0, sizeof(j));
+    j.kind = TMB_JOINT_DISTANCE;
+    j.a = a;
+    j.b = b;
+    j.rest_length = 1.0f;
+    tmb_world_add_joint(&w, &j);
+    CHECK(w.joint_count == 1);
+
+    /* Remove body a: joint should be evicted. */
+    tmb_world_remove_body(&w, a);
+    CHECK(w.joint_count == 0);
+    CHECK(j_validate(&w) == 0);
+
+    step_n(&w, 5);
+    CHECK(j_validate(&w) == 0);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Remove the non-endpoint body so swap-pop patches the joint index. */
+static int test_joint_remap_after_swap_pop(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t a = add_box(&w, -0.5f, 3.0f);  /* body 1 */
+    uint32_t b = add_box(&w,  0.5f, 3.0f);  /* body 2 */
+    uint32_t c = add_box(&w,  1.5f, 3.0f);  /* body 3 */
+
+    /* Joint between a (1) and c (3). */
+    tmb_joint j;
+    memset(&j, 0, sizeof(j));
+    j.kind = TMB_JOINT_REVOLUTE;
+    j.a = a;
+    j.b = c;
+    tmb_world_add_joint(&w, &j);
+    CHECK(w.joint_count == 1);
+
+    /* Remove b (2); c (3=last) moves to slot 2.
+     * Joint's j->b=3 must be patched to 2. */
+    tmb_world_remove_body(&w, b);
+    CHECK(w.joint_count == 1);
+    CHECK(j_validate(&w) == 0);
+
+    step_n(&w, 5);
+    CHECK(j_validate(&w) == 0);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Combined: multiple joints and xjoints, repeated removals. */
+static int test_mixed_joints_removals(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t ids[5];
+    for (int k = 0; k < 5; k++)
+        ids[k] = add_box(&w, (float)k - 2.0f, 3.0f);
+
+    /* Add a mix of joint types. */
+    {
+        tmb_joint j;
+        memset(&j, 0, sizeof(j));
+        j.kind = TMB_JOINT_DISTANCE;
+        j.a = ids[0]; j.b = ids[2]; j.rest_length = 2.0f;
+        tmb_world_add_joint(&w, &j);
+    }
+    {
+        tmb_xjoint xj;
+        tmb_xjoint_weld(&xj, ids[1], ids[3]);
+        tmb_world_add_xjoint(&w, &xj);
+    }
+    {
+        tmb_xjoint xj;
+        tmb_xjoint_weld(&xj, ids[2], ids[4]);
+        tmb_world_add_xjoint(&w, &xj);
+    }
+
+    step_n(&w, 3);
+    CHECK(j_validate(&w) == 0);
+    CHECK(xj_validate(&w) == 0);
+
+    /* Remove the body at the center of the weld chain. */
+    tmb_world_remove_body(&w, ids[2]);
+    CHECK(j_validate(&w) == 0);
+    CHECK(xj_validate(&w) == 0);
+
+    step_n(&w, 5);
+    CHECK(j_validate(&w) == 0);
+    CHECK(xj_validate(&w) == 0);
+
+    /* Drain all but the floor. */
+    while (tmb_world_body_count(&w) > 1) {
+        tmb_world_remove_body(&w, 1);
+        CHECK(j_validate(&w) == 0);
+        CHECK(xj_validate(&w) == 0);
+    }
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+int main(void)
+{
+    int r = 0;
+    r |= test_xjoint_remove_endpoint();
+    r |= test_xjoint_remap_moved_endpoint();
+    r |= test_xjoint_multi_remove();
+    r |= test_joint_remove_endpoint();
+    r |= test_joint_remap_after_swap_pop();
+    r |= test_mixed_joints_removals();
+    TT_DONE();
+}
