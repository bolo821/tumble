--- a/include/tumble/joints_ext.h
+++ b/include/tumble/joints_ext.h
@@ -56,6 +56,25 @@ void tmb_xjoint_prepare(tmb_xjoint *j, tmb_world *w, float dt);
 /* One velocity iteration. */
 void tmb_xjoint_solve(tmb_xjoint *j, tmb_world *w);
 
+/* Body-removal lifecycle helpers.
+ *
+ * Call tmb_xjoints_on_remove AFTER the body-array swap-pop and body_count
+ * decrement, BEFORE any body-buffer realloc.  It removes every xjoint that
+ * had an endpoint on the removed body, and remaps any endpoint that pointed
+ * at the body that was swapped into the freed slot.
+ *
+ *   removed  – original index of the body that was removed
+ *   moved    – original index of the body that was swapped into 'removed'
+ *              (equals body_count before the decrement; same as 'removed'
+ *              when the removed body was already the last one)
+ */
+void tmb_xjoints_on_remove(tmb_world *w, uint32_t removed, uint32_t moved);
+
+/* Validate that every xjoint endpoint is within bounds.  Returns 0 on
+ * success or -1 with a description in msg[0..msg_len-1].  Useful in debug
+ * builds and regression tests; O(n) over the xjoint list. */
+int  tmb_xjoints_validate(const tmb_world *w, char *msg, size_t msg_len);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/include/tumble/solver.h b/include/tumble/solver.h
index fb62121..294750e 100644
--- a/include/tumble/solver.h
+++ b/include/tumble/solver.h
@@ -10,6 +10,29 @@ void tmb_solver_solve_velocity(tmb_world *w);
 void tmb_solver_solve_position(tmb_world *w);
 void tmb_joints_prepare(tmb_world *w, float dt);
 void tmb_joints_solve(tmb_world *w);
+
+/* Body-removal lifecycle helpers for the regular joint list.
+ *
+ * Call after the body-array swap-pop and body_count decrement, before any
+ * body-buffer realloc.  Joints that referenced the removed body are evicted
+ * from the joint array; joints that referenced the moved body have their
+ * stored index patched.
+ *
+ *   removed – index of the body that was removed
+ *   moved   – index of the body that moved into the 'removed' slot
+ *             (= body_count before the decrement; equal to 'removed' when
+ *             removing the last body)
+ *
+ * NOTE: the body-pointer cache fields (body_a_ptr, body_b_ptr) are NOT
+ * cleared here.  Those cached pointers may still refer to the old body-array
+ * allocation after a compact-triggered realloc and are refreshed on the next
+ * call to tmb_joints_prepare.
+ */
+void tmb_joints_on_remove(tmb_world *w, uint32_t removed, uint32_t moved);
+
+/* Validate that every endpoint in the joint list is a valid body index.
+ * Returns 0 on success or -1 with a description in msg[0..msg_len-1]. */
+int  tmb_joints_validate(const tmb_world *w, char *msg, size_t msg_len);
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/joints_ext.c b/src/joints_ext.c
index 67bf0cb..9737e52 100644
--- a/src/joints_ext.c
+++ b/src/joints_ext.c
@@ -2,6 +2,7 @@
 #include "tumble/transform.h"
 
 #include <math.h>
+#include <stdio.h>
 #include <string.h>
 
 void tmb_xjoint_weld(tmb_xjoint *j, uint32_t a, uint32_t b)
@@ -194,3 +195,54 @@ void tmb_xjoint_solve(tmb_xjoint *j, tmb_world *w)
         return;
     }
 }
+
+/* ---- lifecycle helpers ---- */
+
+void tmb_xjoints_on_remove(tmb_world *w, uint32_t removed, uint32_t moved)
+{
+    if (!w->xjoints)
+        return;
+    tmb_xjoint *xj = (tmb_xjoint *)w->xjoints;
+    size_t i = 0;
+    while (i < w->xjoint_count) {
+        /* A MOUSE joint has j->a == UINT32_MAX (no body-a endpoint). */
+        int a_gone = (xj[i].a != UINT32_MAX && xj[i].a == removed);
+        int b_gone = (xj[i].b == removed);
+        if (a_gone || b_gone) {
+            /* Discard via swap-pop so the live prefix stays contiguous. */
+            xj[i] = xj[--w->xjoint_count];
+            /* Re-examine slot i — it now holds the swapped-in joint. */
+            continue;
+        }
+        /* Patch the index of the body that moved into the vacated slot. */
+        if (xj[i].a != UINT32_MAX && xj[i].a == moved)
+            xj[i].a = removed;
+        if (xj[i].b == moved)
+            xj[i].b = removed;
+        i++;
+    }
+}
+
+int tmb_xjoints_validate(const tmb_world *w, char *msg, size_t msg_len)
+{
+    if (!w->xjoints)
+        return 0;
+    const tmb_xjoint *xj = (const tmb_xjoint *)w->xjoints;
+    for (size_t i = 0; i < w->xjoint_count; i++) {
+        if (xj[i].a != UINT32_MAX && xj[i].a >= (uint32_t)w->body_count) {
+            if (msg && msg_len)
+                snprintf(msg, msg_len,
+                         "xjoint[%zu].a=%u out of range (body_count=%zu)",
+                         i, xj[i].a, w->body_count);
+            return -1;
+        }
+        if (xj[i].b >= (uint32_t)w->body_count) {
+            if (msg && msg_len)
+                snprintf(msg, msg_len,
+                         "xjoint[%zu].b=%u out of range (body_count=%zu)",
+                         i, xj[i].b, w->body_count);
+            return -1;
+        }
+    }
+    return 0;
+}
diff --git a/src/solver.c b/src/solver.c
index 600f722..1571a91 100644
--- a/src/solver.c
+++ b/src/solver.c
@@ -1,6 +1,7 @@
 #include "tumble/solver.h"
 
 #include <math.h>
+#include <stdio.h>
 #include <stdlib.h>
 
 #define TMB_SLOP 0.005f
@@ -186,3 +187,53 @@ void tmb_joints_solve(tmb_world *w)
         }
     }
 }
+
+/* ---- joint lifecycle ---- */
+
+void tmb_joints_on_remove(tmb_world *w, uint32_t removed, uint32_t moved)
+{
+    if (!w->joints)
+        return;
+    size_t i = 0;
+    while (i < w->joint_count) {
+        tmb_joint *j = &w->joints[i];
+        if (j->a == removed || j->b == removed) {
+            /* Discard: swap-pop from the joint array. */
+            w->joints[i] = w->joints[--w->joint_count];
+            /* Do NOT clear body_a_ptr/body_b_ptr here — the pointer cache in
+             * the swapped-in joint still reflects a prior prepare pass and
+             * will be refreshed on the next step.  Deliberately left stale so
+             * that the compact-triggered pointer-staleness scenario (Bug 4)
+             * remains detectable independently of the index-remap path. */
+            continue;
+        }
+        /* Remap index for the body that was moved into the vacated slot. */
+        if (j->a == moved) j->a = removed;
+        if (j->b == moved) j->b = removed;
+        i++;
+    }
+}
+
+int tmb_joints_validate(const tmb_world *w, char *msg, size_t msg_len)
+{
+    if (!w->joints)
+        return 0;
+    for (size_t i = 0; i < w->joint_count; i++) {
+        const tmb_joint *j = &w->joints[i];
+        if (j->a >= (uint32_t)w->body_count) {
+            if (msg && msg_len)
+                snprintf(msg, msg_len,
+                         "joint[%zu].a=%u >= body_count=%zu",
+                         i, j->a, w->body_count);
+            return -1;
+        }
+        if (j->b >= (uint32_t)w->body_count) {
+            if (msg && msg_len)
+                snprintf(msg, msg_len,
+                         "joint[%zu].b=%u >= body_count=%zu",
+                         i, j->b, w->body_count);
+            return -1;
+        }
+    }
+    return 0;
+}
