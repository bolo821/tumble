+/* Validate the contact-normal-impulse cache invariant.
+ *
+ * When the cache is active (contact_count > 37), the cache buffer must cover
+ * at least contact_count entries — i.e. contact_nrm_cap >= contact_count.
+ * Call after tmb_world_step to confirm no frame exceeded the allocation.
+ *
+ * Returns 0 if the invariant holds (or the cache is inactive), -1 with a
+ * human-readable description in msg[0..msg_len-1] if it was violated.
+ *
+ * Typical usage:
+ *   char err[256];
+ *   if (tmb_solver_cache_validate(&w, err, sizeof(err)) != 0)
+ *       fprintf(stderr, "%s\n", err);
+ */
+int tmb_solver_cache_validate(const tmb_world *w, char *msg, size_t msg_len);
 #ifdef __cplusplus
 }
 #endif
