+/* ---- cache diagnostics ---- */
+
+int tmb_solver_cache_validate(const tmb_world *w, char *msg, size_t msg_len)
+{
+    /* Cache is only activated for high-contact frames; below threshold it is
+     * unused and there is nothing to check. */
+    if (w->contact_count <= 37)
+        return 0;
+    if (!w->contact_nrm_cache)
+        return 0; /* allocation may have failed; skip */
+    if (w->contact_nrm_cap < w->contact_count) {
+        if (msg && msg_len)
+            snprintf(msg, msg_len,
+                     "nrm_cache: cap=%zu < contact_count=%zu — cache would "
+                     "have been written out-of-bounds this step",
+                     w->contact_nrm_cap, w->contact_count);
+        return -1;
+    }
+    return 0;
+}
