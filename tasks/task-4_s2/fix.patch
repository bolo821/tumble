diff --git a/include/tumble/solver.h b/include/tumble/solver.h
index fb62121..bb5a3cf 100644
--- a/include/tumble/solver.h
+++ b/include/tumble/solver.h
@@ -10,6 +10,13 @@ void tmb_solver_solve_velocity(tmb_world *w);
 void tmb_solver_solve_position(tmb_world *w);
 void tmb_joints_prepare(tmb_world *w, float dt);
 void tmb_joints_solve(tmb_world *w);
+
+/* Null out every joint's cached body pointer (body_a_ptr / body_b_ptr).  The
+ * cache is a fast path populated at the end of tmb_joints_prepare; it becomes
+ * dangling when the body array is reallocated (e.g. the compact realloc in
+ * tmb_world_remove_body).  Call this after any such realloc so the next
+ * prepare pass re-resolves the pointers from the current body array. */
+void tmb_joints_invalidate_ptr_cache(tmb_world *w);
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/solver.c b/src/solver.c
index 600f722..0281ed7 100644
--- a/src/solver.c
+++ b/src/solver.c
@@ -158,6 +158,21 @@ void tmb_joints_prepare(tmb_world *w, float dt)
     }
 }
 
+void tmb_joints_invalidate_ptr_cache(tmb_world *w)
+{
+    /* Null every cached body pointer so the next tmb_joints_prepare falls back
+     * to the index-based &w->bodies[j->a] lookup.  Must be called after any
+     * operation that reallocates the body array (e.g. the compact realloc in
+     * tmb_world_remove_body): realloc may move the allocation, leaving the
+     * previously cached pointers dangling into the freed block. */
+    if (!w->joints)
+        return;
+    for (size_t i = 0; i < w->joint_count; i++) {
+        w->joints[i].body_a_ptr = NULL;
+        w->joints[i].body_b_ptr = NULL;
+    }
+}
+
 void tmb_joints_solve(tmb_world *w)
 {
     for (size_t i = 0; i < w->joint_count; i++) {
diff --git a/src/world.c b/src/world.c
index c44d986..3bdc401 100644
--- a/src/world.c
+++ b/src/world.c
@@ -64,6 +64,12 @@ uint32_t tmb_world_remove_body(tmb_world *w, uint32_t i)
         w->body_cap = 0;
     }
 
+    /* The compact realloc above may have moved the body array.  Any joint that
+     * cached &w->bodies[j->a] / &w->bodies[j->b] from a prior step now holds a
+     * dangling pointer, so drop the cache and let the next prepare pass
+     * re-resolve it against the new allocation. */
+    tmb_joints_invalidate_ptr_cache(w);
+
     return i;
 }
 
