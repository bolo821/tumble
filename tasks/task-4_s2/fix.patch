 void tmb_joints_prepare(tmb_world *w, float dt);
 void tmb_joints_solve(tmb_world *w);
+
+/* Joint body-pointer cache lifecycle.
+ *
+ * tmb_joint stores body_a_ptr / body_b_ptr as a fast path to avoid
+ * re-dereferencing j->a / j->b through w->bodies on every prepare call.
+ * The cache is populated at the END of tmb_joints_prepare and consumed at
+ * the START of the next one.
+ *
+ * The cache becomes stale whenever w->bodies is reallocated: a realloc may
+ * move the allocation to a new address, leaving all previously cached
+ * &w->bodies[j->a] pointers dangling into the freed block.  This happens
+ * whenever tmb_world_remove_body compacts the body buffer.
+ *
+ * tmb_joints_invalidate_ptr_cache() nulls out every cached pointer.  Call
+ * it after any operation that reallocates w->bodies (body removal, pool
+ * resize) so that the next tmb_joints_prepare uses safe index-based access.
+ *
+ * tmb_joints_ptr_cache_valid() is a diagnostic helper: it verifies that
+ * every non-NULL cached pointer falls within the current body array.  Use in
+ * debug builds or tests; O(n) over the joint list.
+ */
+void tmb_joints_invalidate_ptr_cache(tmb_world *w);
+int  tmb_joints_ptr_cache_valid(const tmb_world *w, char *msg, size_t msg_len);
 #ifdef __cplusplus
 }
 #endif
