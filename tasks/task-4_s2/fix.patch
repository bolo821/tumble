+/* ---- joint body-pointer cache management ---- */
+
+void tmb_joints_invalidate_ptr_cache(tmb_world *w)
+{
+    /* Null out every cached body pointer so the next tmb_joints_prepare
+     * invocation falls back to the safe index-based lookup.  Must be called
+     * after any operation that reallocates or moves the body array (e.g. a
+     * body removal followed by the compact realloc in tmb_world_remove_body),
+     * because realloc may change the base address of w->bodies, making all
+     * previously cached &w->bodies[j->a] / &w->bodies[j->b] addresses
+     * dangle into the freed allocation. */
+    if (!w->joints)
+        return;
+    for (size_t i = 0; i < w->joint_count; i++) {
+        w->joints[i].body_a_ptr = NULL;
+        w->joints[i].body_b_ptr = NULL;
+    }
+}
+
+int tmb_joints_ptr_cache_valid(const tmb_world *w, char *msg, size_t msg_len)
+{
+    /* A NULL cached pointer is always valid (it means the next prepare pass
+     * will use the index directly).  A non-NULL pointer is valid iff it falls
+     * within the current body array.  After a compact realloc, a non-NULL
+     * pointer that was set before the realloc will usually point outside the
+     * new allocation; ASan catches the subsequent dereference as UAF. */
+    if (!w->joints || !w->bodies)
+        return 0;
+    for (size_t i = 0; i < w->joint_count; i++) {
+        const tmb_joint *j = &w->joints[i];
+        if (j->body_a_ptr) {
+            ptrdiff_t off = j->body_a_ptr - w->bodies;
+            if (off < 0 || (size_t)off >= w->body_count) {
+                if (msg && msg_len)
+                    snprintf(msg, msg_len,
+                             "joint[%zu].body_a_ptr offset=%td out of body array "
+                             "[0,%zu)",
+                             i, off, w->body_count);
+                return -1;
+            }
+        }
+        if (j->body_b_ptr) {
+            ptrdiff_t off = j->body_b_ptr - w->bodies;
+            if (off < 0 || (size_t)off >= w->body_count) {
+                if (msg && msg_len)
+                    snprintf(msg, msg_len,
+                             "joint[%zu].body_b_ptr offset=%td out of body array "
+                             "[0,%zu)",
+                             i, off, w->body_count);
+                return -1;
+            }
+        }
+    }
+    return 0;
+}
+
 void tmb_joints_solve(tmb_world *w)
 {
     for (size_t i = 0; i < w->joint_count; i++) {
