diff --git a/tests/test_joint_ptr_cache.c b/tests/test_joint_ptr_cache.c
new file mode 100644
index 0000000..2e0389e
--- /dev/null
+++ b/tests/test_joint_ptr_cache.c
@@ -0,0 +1,281 @@
+/* Regression tests for the joint body-pointer cache lifetime.
+ *
+ * tmb_joint caches body_a_ptr / body_b_ptr as a fast path inside
+ * tmb_joints_prepare.  The cache is set at the END of one prepare call and
+ * consumed at the START of the next.  If the body array is reallocated
+ * between two prepare calls (e.g. because tmb_world_remove_body compacted it),
+ * the cached pointers dangle into the freed allocation.  On the next step,
+ * tmb_joints_prepare dereferences them → heap-use-after-free.
+ *
+ * The fix calls tmb_joints_invalidate_ptr_cache after the compact realloc,
+ * nulling all cached pointers so the next prepare falls back to safe index
+ * lookup.
+ *
+ * All tests run under ASan so any stale-pointer dereference is caught. */
+
+#include "tumble/tumble.h"
+#include "tumble/solver.h"
+
+#include "tttest.h"
+#include <stdio.h>
+#include <string.h>
+
+/* ---- helpers ---- */
+
+static tmb_world make_world(void)
+{
+    tmb_world w;
+    tmb_world_init(&w);
+    w.gravity = tmb_v2(0.0f, -10.0f);
+    return w;
+}
+
+static uint32_t add_box(tmb_world *w, float x, float y)
+{
+    tmb_body b;
+    tmb_body_init(&b, TMB_BODY_DYNAMIC, tmb_shape_box(0.5f, 0.5f),
+                  tmb_v2(x, y));
+    return tmb_world_add_body(w, &b);
+}
+
+static void add_floor(tmb_world *w)
+{
+    tmb_body f;
+    tmb_body_init(&f, TMB_BODY_STATIC, tmb_shape_box(20.0f, 1.0f),
+                  tmb_v2(0, -5.0f));
+    tmb_world_add_body(w, &f);
+}
+
+static uint32_t add_distance_joint(tmb_world *w, uint32_t a, uint32_t b)
+{
+    tmb_joint j;
+    memset(&j, 0, sizeof(j));
+    j.kind = TMB_JOINT_DISTANCE;
+    j.a = a;
+    j.b = b;
+    j.rest_length = 1.0f;
+    return tmb_world_add_joint(w, &j);
+}
+
+static int ptr_ok(const tmb_world *w)
+{
+    char msg[256];
+    int rc = tmb_joints_ptr_cache_valid(w, msg, sizeof(msg));
+    if (rc != 0)
+        fprintf(stderr, "  ptr_cache: %s\n", msg);
+    return rc;
+}
+
+/* ---- tests ---- */
+
+/* Base case: add bodies + joint, step once (populates cache), remove a
+ * third unrelated body (triggers compact), verify cache is now NULL.
+ * A second step must complete without a crash (on the unfixed code the
+ * stale pointer would be dereferenced here by tmb_joints_prepare). */
+static int test_ptr_cache_cleared_after_bystander_remove(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t a = add_box(&w,  0.0f, 2.0f);  /* joint endpoint */
+    uint32_t b = add_box(&w,  1.5f, 2.0f);  /* joint endpoint */
+    uint32_t c = add_box(&w, -1.5f, 2.0f);  /* bystander: removed below */
+    (void)c;
+    add_distance_joint(&w, a, b);
+
+    /* Populate the pointer cache. */
+    tmb_world_step(&w, 1.0f / 60.0f);
+    CHECK(w.joints[0].body_a_ptr != NULL);
+    CHECK(w.joints[0].body_b_ptr != NULL);
+    CHECK(ptr_ok(&w) == 0);
+
+    /* Remove the bystander: triggers compact realloc.
+     * The fix nulls both cached pointers immediately. */
+    tmb_world_remove_body(&w, c);
+    CHECK(w.joints[0].body_a_ptr == NULL);
+    CHECK(w.joints[0].body_b_ptr == NULL);
+    CHECK(ptr_ok(&w) == 0);
+
+    /* Next step must not crash (unfixed code reads freed memory here). */
+    tmb_world_step(&w, 1.0f / 60.0f);
+    CHECK(ptr_ok(&w) == 0);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Two separate joints, one bystander.  Both joints' caches must be cleared
+ * together after a single remove. */
+static int test_ptr_cache_two_joints_one_remove(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t a = add_box(&w,  0.0f, 2.0f);
+    uint32_t b = add_box(&w,  1.5f, 2.0f);
+    uint32_t c = add_box(&w,  3.0f, 2.0f);
+    uint32_t d = add_box(&w, -1.5f, 5.0f);  /* bystander */
+    (void)d;
+    add_distance_joint(&w, a, b);
+    add_distance_joint(&w, b, c);
+
+    /* Cache both joints. */
+    tmb_world_step(&w, 1.0f / 60.0f);
+    CHECK(w.joint_count == 2);
+    CHECK(w.joints[0].body_a_ptr != NULL);
+    CHECK(w.joints[1].body_a_ptr != NULL);
+    CHECK(ptr_ok(&w) == 0);
+
+    /* Remove bystander d: triggers compact; both pointers must be nulled. */
+    tmb_world_remove_body(&w, d);
+    CHECK(w.joints[0].body_a_ptr == NULL);
+    CHECK(w.joints[0].body_b_ptr == NULL);
+    CHECK(w.joints[1].body_a_ptr == NULL);
+    CHECK(w.joints[1].body_b_ptr == NULL);
+    CHECK(ptr_ok(&w) == 0);
+
+    /* Both joints must continue to function after cache refresh. */
+    tmb_world_step(&w, 1.0f / 60.0f);
+    CHECK(ptr_ok(&w) == 0);
+    CHECK(w.joint_count == 2);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Multiple bystander removes in sequence: the cache is nulled each time and
+ * the engine continues stepping cleanly between removes. */
+static int test_ptr_cache_across_multiple_bystander_removes(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    /* joint endpoints at high indices so we can remove low-index bystanders */
+    uint32_t b0 = add_box(&w, 5.0f, 2.0f);
+    uint32_t b1 = add_box(&w, 6.5f, 2.0f);
+    /* bystanders at low indices that will be removed */
+    uint32_t by0 = add_box(&w, -5.0f, 2.0f);
+    uint32_t by1 = add_box(&w, -3.5f, 2.0f);
+    uint32_t by2 = add_box(&w, -2.0f, 2.0f);
+    (void)b0; (void)b1; (void)by0; (void)by1; (void)by2;
+    add_distance_joint(&w, b0, b1);
+
+    for (int i = 0; i < 3; i++)
+        tmb_world_step(&w, 1.0f / 60.0f);
+    CHECK(ptr_ok(&w) == 0);
+
+    /* Remove first bystander; step; repeat. */
+    for (int round = 0; round < 3; round++) {
+        if (tmb_world_body_count(&w) <= 3)
+            break;
+        /* Always remove index 1 (first dynamic body that is not a joint ep). */
+        tmb_world_remove_body(&w, 1);
+
+        /* Immediately after remove: all caches must be NULL. */
+        for (size_t k = 0; k < w.joint_count; k++) {
+            CHECK(w.joints[k].body_a_ptr == NULL);
+            CHECK(w.joints[k].body_b_ptr == NULL);
+        }
+        CHECK(ptr_ok(&w) == 0);
+
+        /* After the next step the cache is refreshed. */
+        tmb_world_step(&w, 1.0f / 60.0f);
+        CHECK(ptr_ok(&w) == 0);
+    }
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Validate that a live cache (set by a step with no intervening removal)
+ * always refers to slots within the current body array. */
+static int test_ptr_cache_live_after_step(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t a = add_box(&w, 0.0f, 2.0f);
+    uint32_t b = add_box(&w, 1.5f, 2.0f);
+    (void)a; (void)b;
+    add_distance_joint(&w, a, b);
+
+    for (int i = 0; i < 30; i++) {
+        tmb_world_step(&w, 1.0f / 60.0f);
+        CHECK(ptr_ok(&w) == 0);
+    }
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Revolute joint (kind != DISTANCE): same pointer cache; same fix applies. */
+static int test_ptr_cache_revolute_joint_bystander_remove(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t a = add_box(&w, 0.0f, 2.0f);
+    uint32_t b = add_box(&w, 0.0f, 3.5f);
+    uint32_t c = add_box(&w, 5.0f, 2.0f);  /* bystander */
+    (void)c;
+
+    tmb_joint j;
+    memset(&j, 0, sizeof(j));
+    j.kind = TMB_JOINT_REVOLUTE;
+    j.a = a;
+    j.b = b;
+    tmb_world_add_joint(&w, &j);
+
+    /* Step once to fill the cache. */
+    tmb_world_step(&w, 1.0f / 60.0f);
+    CHECK(w.joints[0].body_a_ptr != NULL);
+    CHECK(ptr_ok(&w) == 0);
+
+    /* Remove bystander c: triggers compact. */
+    tmb_world_remove_body(&w, c);
+    CHECK(w.joints[0].body_a_ptr == NULL);
+    CHECK(ptr_ok(&w) == 0);
+
+    tmb_world_step(&w, 1.0f / 60.0f);
+    CHECK(ptr_ok(&w) == 0);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Remove the last body (no swap-pop needed) with a joint referencing earlier
+ * bodies: body count shrinks so the compact realloc still fires.  Cache must
+ * still be invalidated. */
+static int test_ptr_cache_remove_last_body(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t a = add_box(&w, 0.0f, 2.0f);  /* index 1 */
+    uint32_t b = add_box(&w, 1.5f, 2.0f);  /* index 2 */
+    uint32_t c = add_box(&w, 3.0f, 2.0f);  /* index 3, bystander */
+    (void)c;
+    add_distance_joint(&w, a, b);
+
+    tmb_world_step(&w, 1.0f / 60.0f);
+    CHECK(w.joints[0].body_a_ptr != NULL);
+    CHECK(ptr_ok(&w) == 0);
+
+    /* Remove the last body (index 3 = c): no swap-pop, but compact fires. */
+    tmb_world_remove_body(&w, c);
+    CHECK(w.joints[0].body_a_ptr == NULL);
+    CHECK(w.joints[0].body_b_ptr == NULL);
+    CHECK(ptr_ok(&w) == 0);
+
+    tmb_world_step(&w, 1.0f / 60.0f);
+    CHECK(ptr_ok(&w) == 0);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+int main(void)
+{
+    int r = 0;
+    r |= test_ptr_cache_cleared_after_bystander_remove();
+    r |= test_ptr_cache_two_joints_one_remove();
+    r |= test_ptr_cache_across_multiple_bystander_removes();
+    r |= test_ptr_cache_live_after_step();
+    r |= test_ptr_cache_revolute_joint_bystander_remove();
+    r |= test_ptr_cache_remove_last_body();
+    TT_DONE();
+}
