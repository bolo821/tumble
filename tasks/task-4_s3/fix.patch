+    TMB_TRI_EDGE_AB,
+    TMB_TRI_EDGE_BC,
+    TMB_TRI_EDGE_CA,
+    TMB_TRI_INSIDE
+} tmb_tri_region;
+
+/* Closest point to p on triangle (a,b,c). When region is non-NULL it receives
