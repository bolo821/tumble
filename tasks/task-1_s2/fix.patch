diff --git a/tests/test_sleep_records.c b/tests/test_sleep_records.c
new file mode 100644
index 0000000..927f126
--- /dev/null
+++ b/tests/test_sleep_records.c
@@ -0,0 +1,218 @@
+/* Unit tests for the island-sleep record lifecycle, especially the ownership
+ * invariants around tmb_sleep_on_remove.
+ *
+ * The regression scenario that must be covered:
+ *   1. Let two or more dynamic bodies settle into a sleeping island.
+ *   2. Remove one body from the island while the world still has others.
+ *   3. Verify that the surviving record has its own independent members[]
+ *      allocation (no aliasing with the freed original).
+ *   4. Wake the surviving island and confirm all member indices are valid.
+ *   5. Validate the full sleep system after every mutation. */
+
+#include "tumble/tumble.h"
+#include "tumble/island_sleep.h"
+#include "tumble/warmstart.h"
+
+#include "tttest.h"
+#include <string.h>
+
+/* ---- helpers ---- */
+
+static tmb_world make_world(void)
+{
+    tmb_world w;
+    tmb_world_init(&w);
+    w.gravity        = tmb_v2(0.0f, -10.0f);
+    w.enable_sleeping = 1;
+    return w;
+}
+
+static uint32_t add_box(tmb_world *w, float x, float y)
+{
+    tmb_body b;
+    tmb_body_init(&b, TMB_BODY_DYNAMIC, tmb_shape_box(0.5f, 0.5f), tmb_v2(x, y));
+    return tmb_world_add_body(w, &b);
+}
+
+static void add_floor(tmb_world *w)
+{
+    tmb_body f;
+    tmb_body_init(&f, TMB_BODY_STATIC, tmb_shape_box(20.0f, 1.0f), tmb_v2(0, -3));
+    tmb_world_add_body(w, &f);
+}
+
+static void step_n(tmb_world *w, int n)
+{
+    for (int i = 0; i < n; i++)
+        tmb_world_step(w, 1.0f / 60.0f);
+}
+
+static int validate(const tmb_world *w)
+{
+    char msg[256];
+    int rc = tmb_sleep_validate(w, msg, sizeof(msg));
+    if (rc != 0)
+        fprintf(stderr, "  validate: %s\n", msg);
+    return rc;
+}
+
+/* ---- tests ---- */
+
+/* Two bodies settle into a single sleeping island; we remove one and confirm
+ * the survivor's record is self-consistent (no aliased members pointer). */
+static int test_remove_from_two_body_island(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t a = add_box(&w, -0.5f, 1.0f);
+    uint32_t b = add_box(&w,  0.5f, 1.0f);
+
+    /* Run long enough for both bodies to settle and sleep. */
+    step_n(&w, 120);
+
+    CHECK(tmb_body_is_sleeping(&w, a));
+    CHECK(tmb_body_is_sleeping(&w, b));
+    CHECK(validate(&w) == 0);
+
+    /* Remove body a while both are sleeping. */
+    tmb_world_remove_body(&w, a);
+
+    /* After the removal the system must still be valid. */
+    CHECK(validate(&w) == 0);
+
+    /* The surviving body should still be asleep (it was not disturbed). */
+    /* Note: after swap-pop body b may have moved to a different slot; use
+     * body_count to find it (only 2 bodies remain: floor + 1 dynamic). */
+    size_t bc = tmb_world_body_count(&w);
+    CHECK(bc == 2);
+
+    /* Step once more to verify the engine does not crash when the surviving
+     * sleeping island is touched (e.g. during wake logic). */
+    step_n(&w, 5);
+    CHECK(validate(&w) == 0);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Three bodies in one island; remove the middle one (swap-pop moves the
+ * last into its slot) and confirm all back-pointers are updated correctly. */
+static int test_remove_middle_of_three(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    uint32_t a = add_box(&w, -1.0f, 1.0f);
+    uint32_t b = add_box(&w,  0.0f, 1.0f);
+    uint32_t c = add_box(&w,  1.0f, 1.0f);
+    (void)a; (void)b; (void)c;
+
+    step_n(&w, 120);
+
+    /* All dynamic bodies should be sleeping by now. */
+    for (uint32_t i = 1; i < (uint32_t)tmb_world_body_count(&w); i++)
+        CHECK(tmb_body_is_sleeping(&w, i));
+
+    CHECK(validate(&w) == 0);
+
+    /* Remove the second dynamic body (index 2 = b). */
+    tmb_world_remove_body(&w, 2);
+    CHECK(validate(&w) == 0);
+
+    step_n(&w, 10);
+    CHECK(validate(&w) == 0);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Remove all members of a sleeping island one by one and confirm the system
+ * reaches a clean empty state each time. */
+static int test_drain_island(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    for (int i = 0; i < 4; i++)
+        add_box(&w, (float)i * 0.8f - 1.2f, 1.0f);
+
+    step_n(&w, 150);
+    CHECK(validate(&w) == 0);
+
+    /* Remove dynamic bodies one at a time until none remain. */
+    while (tmb_world_body_count(&w) > 1) {
+        tmb_world_remove_body(&w, 1);  /* always remove the first dynamic body */
+        CHECK(validate(&w) == 0);
+    }
+
+    step_n(&w, 5);
+    CHECK(validate(&w) == 0);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Waking a sleeping island after a remove must not dereference the freed
+ * members array; this test specifically exercises wake_island on the record
+ * produced by tmb_sleep_on_remove. */
+static int test_wake_after_remove(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    add_box(&w, -0.4f, 1.0f);
+    add_box(&w,  0.4f, 1.0f);
+    add_box(&w,  0.0f, 2.2f);
+
+    step_n(&w, 150);
+    CHECK(validate(&w) == 0);
+
+    /* Remove one member to produce a two-body survivor record. */
+    tmb_world_remove_body(&w, 1);
+    CHECK(validate(&w) == 0);
+
+    /* Drop a heavy box from above to land on the survivors and wake them. */
+    tmb_body heavy;
+    tmb_body_init(&heavy, TMB_BODY_DYNAMIC, tmb_shape_box(1.0f, 1.0f),
+                  tmb_v2(0.0f, 8.0f));
+    tmb_world_add_body(&w, &heavy);
+
+    /* The impact should wake the sleeping island; running many steps must
+     * not crash even though one body was removed. */
+    step_n(&w, 60);
+    CHECK(validate(&w) == 0);
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+/* Validate that sleeping_count stays consistent across many add/remove/sleep
+ * cycles. */
+static int test_sleeping_count_consistency(void)
+{
+    tmb_world w = make_world();
+    add_floor(&w);
+    for (int i = 0; i < 6; i++)
+        add_box(&w, (float)i - 2.5f, 1.5f);
+
+    for (int round = 0; round < 3; round++) {
+        step_n(&w, 100);
+        CHECK(validate(&w) == 0);
+
+        if (tmb_world_body_count(&w) > 2) {
+            tmb_world_remove_body(&w, 1);
+            CHECK(validate(&w) == 0);
+        }
+    }
+
+    tmb_world_free(&w);
+    return 0;
+}
+
+int main(void)
+{
+    int r = 0;
+    r |= test_remove_from_two_body_island();
+    r |= test_remove_middle_of_three();
+    r |= test_drain_island();
+    r |= test_wake_after_remove();
+    r |= test_sleeping_count_consistency();
+    TT_DONE();
+}
