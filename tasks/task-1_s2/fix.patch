+/* ---- Diagnostic validation ---- */
+
+#include <stdio.h>
+
+int tmb_sleep_validate(const tmb_world *w, char *msg, size_t msg_len)
+{
+    if (!w->sleep || !w->enable_sleeping)
+        return 0;
+
+    const tmb_sleep_system *s = w->sleep;
+    size_t n = w->body_count;
+
+#define FAIL(fmt, ...) \
+    do { \
+        if (msg && msg_len) snprintf(msg, msg_len, fmt, ##__VA_ARGS__); \
+        return -1; \
+    } while (0)
+
+    /* 1. Every owned record must have a non-NULL, non-empty members array and
+     *    all member indices must be within the current body count. */
+    size_t total_members = 0;
+    for (size_t r = 0; r < s->owned_count; r++) {
+        const tmb_island_rec *rec = s->owned[r];
+        if (!rec)
+            FAIL("owned[%zu] is NULL", r);
+        if (rec->count <= 0)
+            FAIL("owned[%zu] has count=%d", r, rec->count);
+        if (!rec->members)
+            FAIL("owned[%zu] members is NULL (count=%d)", r, rec->count);
+        if (rec->count > rec->cap)
+            FAIL("owned[%zu] count %d > cap %d", r, rec->count, rec->cap);
+        for (int k = 0; k < rec->count; k++) {
+            uint32_t m = rec->members[k];
+            if (m >= (uint32_t)n)
+                FAIL("owned[%zu] member[%d]=%u out of range (body_count=%zu)",
+                     r, k, m, n);
+        }
+        total_members += (size_t)rec->count;
+    }
+
+    /* 2. sleeping_count must equal the sum of all owned records' member counts. */
+    if (s->sleeping_count != total_members)
+        FAIL("sleeping_count=%zu but total owned members=%zu",
+             s->sleeping_count, total_members);
+
+    /* 3. For every body marked asleep, body_rec[body] must point to an owned
+     *    record, and that record must list the body as a member. */
+    for (size_t i = 0; i < n && i < s->cap; i++) {
+        if (!s->asleep[i])
+            continue;
+        const tmb_island_rec *rec = s->body_rec[i];
+        if (!rec)
+            FAIL("body %zu is asleep but body_rec[%zu] is NULL", i, i);
+        /* Verify rec is in owned[]. */
+        int found_in_owned = 0;
+        for (size_t r = 0; r < s->owned_count; r++) {
+            if (s->owned[r] == rec) { found_in_owned = 1; break; }
+        }
+        if (!found_in_owned)
+            FAIL("body %zu body_rec points to record not in owned[]", i);
+        /* Verify body i appears in rec->members. */
+        int found_in_members = 0;
+        for (int k = 0; k < rec->count; k++) {
+            if (rec->members[k] == (uint32_t)i) { found_in_members = 1; break; }
+        }
+        if (!found_in_members)
+            FAIL("body %zu is asleep, body_rec points to record that does "
+                 "not list it as a member", i);
+    }
+
+    /* 4. No two owned records may share a members[] allocation (catches shallow-
+     *    copy aliasing: if *new = *old was used, both would point to the same
+     *    heap block and freeing one would leave the other dangling). */
+    for (size_t r = 0; r < s->owned_count; r++) {
+        for (size_t q = r + 1; q < s->owned_count; q++) {
+            if (s->owned[r]->members == s->owned[q]->members)
+                FAIL("owned[%zu] and owned[%zu] share members[] allocation "
+                     "(shallow-copy aliasing)", r, q);
+        }
+    }
+
+#undef FAIL
+    return 0;
+}
