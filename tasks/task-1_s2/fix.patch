+/* ---- Diagnostic / validation ---- */
+
+/* Walk every owned island record and every per-body record pointer and check
+ * that the system is internally consistent:
+ *   - All owned records appear in owned[] exactly once.
+ *   - All member indices are within the current body count.
+ *   - Every member's body_rec[] back-pointer matches the owning record.
+ *   - No two different owned records share a members[] allocation (catches
+ *     shallow-copy aliasing bugs).
+ *   - sleeping_count equals the total member count across all owned records.
+ * Returns 0 if all checks pass; returns -1 and writes a description to
+ * `msg` (truncated to `msg_len` bytes) on the first violation found.
+ * Safe to call from assertions in release builds; returns 0 immediately
+ * when sleeping is disabled or no sleep system exists. */
+int tmb_sleep_validate(const tmb_world *w, char *msg, size_t msg_len);
+
