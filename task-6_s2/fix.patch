+/* Apply per-step velocity damping to all dynamic bodies.
+ * Called from tmb_world_step() after position integration.
+ * linear_damping and angular_damping are dimensionless fractions: 0 = no
+ * decay, 0.01 = 1% lost per step (the engine default), 1 = full stop. */
+void tmb_apply_damping(tmb_world *w, float dt)
+{
+    (void)dt;
+    if (w->linear_damping <= 0.0f && w->angular_damping <= 0.0f)
+        return;
+
+    float ld = 1.0f - w->linear_damping;
+    float ad = 1.0f - w->angular_damping;
+
+    for (size_t i = 0; i < w->body_count; i++) {
+        tmb_body *b = &w->bodies[i];
+        if (b->type != TMB_BODY_DYNAMIC)
+            continue;
+        b->vel.x   *= ld;
+        b->vel.y   *= ld;
+        b->ang_vel *= ad;
+    }
+}
