+void tmb_integrate_stats(const tmb_world *w,
+                         size_t *out_active,
+                         size_t *out_sleeping)
+{
+    size_t active   = 0;
+    size_t sleeping = 0;
+    for (size_t i = 0; i < w->body_count; i++) {
+        const tmb_body *b = &w->bodies[i];
+        if (b->type != TMB_BODY_DYNAMIC)
+            continue;
+        if (tmb_body_is_sleeping(w, (uint32_t)i))
+            sleeping++;
+        else
+            active++;
+    }
+    if (out_active)   *out_active   = active;
+    if (out_sleeping) *out_sleeping = sleeping;
+}
