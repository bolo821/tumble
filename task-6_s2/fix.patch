+/* Fix: loop bound is strictly i < body_count, not i <= body_count.
+ * The old <= caused an off-by-one write to bodies[body_count] when
+ * body_count == body_cap, overrunning the heap allocation. */
+void tmb_integrate_velocities(tmb_world *w, float dt)
+{
