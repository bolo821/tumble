--- a/include/tumble/broadphase.h
+++ b/include/tumble/broadphase.h
@@ -1,7 +1,33 @@
 #pragma once
 #include "world.h"
+#include "aabb.h"
+#include "vec2.h"
+#include <stddef.h>
 
+/* -------------------------------------------------------------------------
+ * Broadphase collision detection for tmb_world.
+ *
+ * Phase 1 - AABB collection (broadphase_collect_aabbs):
+ *   Build a compact array of AABBs one entry per body.  Allocates exactly n
+ *   slots so the fill loop can never write out of bounds.
+ *
+ * Phase 2 - Sweep-and-prune (SAP) sort by min-x:
+ *   Sort the compact array by AABB min-x.  Once a candidate min-x exceeds
+ *   the current body max-x the inner loop breaks early, reducing pair tests.
+ *
+ * Phase 3 - Narrowphase dispatch (broadphase_test_pair):
+ *   For each overlapping AABB pair that is not static-static, forward to
+ *   tmb_collide() which appends contacts to the world.
+ * ------------------------------------------------------------------------- */
+
+/* Run a full broadphase + narrowphase step, appending contacts to w. */
 void tmb_broadphase_collide(tmb_world *w);
+
+/* Query whether the world-space point p overlaps the AABB of any body.
+ * Returns the index of the first matching body, or SIZE_MAX when none found.
+ * Only the body AABB (not the exact shape) is tested; this is a fast coarse
+ * check suitable for picking and ray-marching pre-filters. */
+size_t tmb_broadphase_query_point(const tmb_world *w, tmb_vec2 p);
--- a/src/broadphase.c
+++ b/src/broadphase.c
@@ -1,35 +1,202 @@
 #include "tumble/broadphase.h"
 #include "tumble/collide.h"
 #include "tumble/shape.h"
+#include "tumble/body.h"
+#include "tumble/aabb.h"
 
 #include <stdlib.h>
+#include <stddef.h>
+#include <float.h>
 
