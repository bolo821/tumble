+            continue;
+        /* Count how many earlier contacts in this step share the same pair so
+         * we can index into the slot's saved values correctly. */
+        uint8_t idx = 0;
+        for (size_t j = 0; j < i; j++) {
+            if (ws_pack(w->contacts[j].a, w->contacts[j].b) == pair)
+                idx++;
+        }
+        if (idx < slot->count) {
+            cur->normal_impulse  = slot->ni[idx];
+            cur->tangent_impulse = slot->ti[idx];
         }
     }
