diff --git a/tests/test_warmstart.c b/tests/test_warmstart.c
new file mode 100644
index 0000000..cee06e2
--- /dev/null
+++ b/tests/test_warmstart.c
@@ -0,0 +1,243 @@
+#include "tumble/warmstart.h"
+#include "tumble/contact.h"
+#include "tumble/world.h"
+#include "tttest.h"
+
+#include <string.h>
+#include <stdint.h>
+
+/* ------------------------------------------------------------------ helpers */
+
+static tmb_contact make_contact(uint32_t a, uint32_t b,
+                                float ni, float ti)
+{
+    tmb_contact c;
+    memset(&c, 0, sizeof(c));
+    c.a = a;
+    c.b = b;
+    c.normal_impulse  = ni;
+    c.tangent_impulse = ti;
+    c.sibling = TMB_NO_SIBLING;
+    return c;
+}
+
+static void world_set_contacts(tmb_world *w, tmb_contact *arr, size_t n)
+{
+    w->contacts      = arr;
+    w->contact_count = n;
+}
+
+/* ------------------------------------------------------------------ tests */
+
+/* Basic round-trip: store one contact, apply it the next frame. */
+static void test_basic_store_apply(void)
+{
+    tmb_ws_cache c;
+    tmb_ws_cache_init(&c);
+
+    tmb_world w;
+    tmb_world_init(&w);
+
+    tmb_contact prev = make_contact(1, 2, 3.5f, -1.2f);
+    world_set_contacts(&w, &prev, 1);
+    tmb_ws_store(&c, &w);
+
+    /* Next frame: same pair, zeroed impulses — apply should restore them. */
+    tmb_contact cur = make_contact(1, 2, 0.0f, 0.0f);
+    world_set_contacts(&w, &cur, 1);
+    tmb_ws_apply(&c, &w);
+
+    CHECK_NEAR(cur.normal_impulse,  3.5f,  1e-5f);
+    CHECK_NEAR(cur.tangent_impulse, -1.2f, 1e-5f);
+
+    w.contacts = NULL; w.contact_count = 0;
+    tmb_world_free(&w);
+    tmb_ws_cache_free(&c);
+}
+
+/* Pair order independence: (b,a) same pair as (a,b). */
+static void test_pair_symmetry(void)
+{
+    tmb_ws_cache c;
+    tmb_ws_cache_init(&c);
+
+    tmb_world w;
+    tmb_world_init(&w);
+
+    tmb_contact prev = make_contact(7, 3, 2.0f, 0.5f);
+    world_set_contacts(&w, &prev, 1);
+    tmb_ws_store(&c, &w);
+
+    tmb_contact cur = make_contact(3, 7, 0.0f, 0.0f);   /* reversed */
+    world_set_contacts(&w, &cur, 1);
+    tmb_ws_apply(&c, &w);
+
+    CHECK_NEAR(cur.normal_impulse,  2.0f, 1e-5f);
+    CHECK_NEAR(cur.tangent_impulse, 0.5f, 1e-5f);
+
+    w.contacts = NULL; w.contact_count = 0;
+    tmb_world_free(&w);
+    tmb_ws_cache_free(&c);
+}
+
+/* Two-point manifold: both contact points carry forward independently. */
+static void test_two_point_manifold(void)
+{
+    tmb_ws_cache c;
+    tmb_ws_cache_init(&c);
+
+    tmb_world w;
+    tmb_world_init(&w);
+
+    tmb_contact prev[2];
+    prev[0] = make_contact(0, 1, 1.0f, 0.1f);
+    prev[1] = make_contact(0, 1, 2.0f, 0.2f);
+    world_set_contacts(&w, prev, 2);
+    tmb_ws_store(&c, &w);
+
+    tmb_contact cur[2];
+    cur[0] = make_contact(0, 1, 0.0f, 0.0f);
+    cur[1] = make_contact(0, 1, 0.0f, 0.0f);
+    world_set_contacts(&w, cur, 2);
+    tmb_ws_apply(&c, &w);
+
+    CHECK_NEAR(cur[0].normal_impulse,  1.0f, 1e-5f);
+    CHECK_NEAR(cur[0].tangent_impulse, 0.1f, 1e-5f);
+    CHECK_NEAR(cur[1].normal_impulse,  2.0f, 1e-5f);
+    CHECK_NEAR(cur[1].tangent_impulse, 0.2f, 1e-5f);
+
+    w.contacts = NULL; w.contact_count = 0;
+    tmb_world_free(&w);
+    tmb_ws_cache_free(&c);
+}
+
+/* Multiple distinct pairs in the same cache. */
+static void test_multiple_pairs(void)
+{
+    tmb_ws_cache c;
+    tmb_ws_cache_init(&c);
+
+    tmb_world w;
+    tmb_world_init(&w);
+
+    tmb_contact prev[3];
+    prev[0] = make_contact(0, 1, 1.0f, 0.0f);
+    prev[1] = make_contact(2, 3, 4.0f, 0.5f);
+    prev[2] = make_contact(5, 6, 7.0f, 0.7f);
+    world_set_contacts(&w, prev, 3);
+    tmb_ws_store(&c, &w);
+
+    tmb_contact cur[3];
+    cur[0] = make_contact(5, 6, 0.0f, 0.0f);
+    cur[1] = make_contact(0, 1, 0.0f, 0.0f);
+    cur[2] = make_contact(2, 3, 0.0f, 0.0f);
+    world_set_contacts(&w, cur, 3);
+    tmb_ws_apply(&c, &w);
+
+    CHECK_NEAR(cur[0].normal_impulse,  7.0f, 1e-5f);
+    CHECK_NEAR(cur[1].normal_impulse,  1.0f, 1e-5f);
+    CHECK_NEAR(cur[2].normal_impulse,  4.0f, 1e-5f);
+    CHECK_NEAR(cur[2].tangent_impulse, 0.5f, 1e-5f);
+
+    w.contacts = NULL; w.contact_count = 0;
+    tmb_world_free(&w);
+    tmb_ws_cache_free(&c);
+}
+
+/* Pair disappears for a frame then reappears — should get zero (stale cleared). */
+static void test_pair_disappear_reappear(void)
+{
+    tmb_ws_cache c;
+    tmb_ws_cache_init(&c);
+
+    tmb_world w;
+    tmb_world_init(&w);
+
+    /* Frame 1: pair (1,2) present. */
+    tmb_contact f1 = make_contact(1, 2, 9.0f, 3.0f);
+    world_set_contacts(&w, &f1, 1);
+    tmb_ws_store(&c, &w);
+
+    /* Frame 2: pair (1,2) absent — store with empty world. */
+    world_set_contacts(&w, NULL, 0);
+    tmb_ws_store(&c, &w);
+
+    /* Frame 3: pair (1,2) reappears — should NOT get stale impulses. */
+    tmb_contact f3 = make_contact(1, 2, 0.0f, 0.0f);
+    world_set_contacts(&w, &f3, 1);
+    tmb_ws_apply(&c, &w);
+
+    CHECK_NEAR(f3.normal_impulse,  0.0f, 1e-5f);
+    CHECK_NEAR(f3.tangent_impulse, 0.0f, 1e-5f);
+
+    w.contacts = NULL; w.contact_count = 0;
+    tmb_world_free(&w);
+    tmb_ws_cache_free(&c);
+}
+
+/* Multiple simulation steps: impulses accumulate across frames correctly. */
+static void test_multiple_steps(void)
+{
+    tmb_ws_cache c;
+    tmb_ws_cache_init(&c);
+
+    tmb_world w;
+    tmb_world_init(&w);
+
+    float ni = 0.0f, ti = 0.0f;
+    for (int step = 0; step < 5; step++) {
+        /* Simulate solver settling: each step ni grows by 1. */
+        ni += 1.0f;
+        ti += 0.5f;
+        tmb_contact prev = make_contact(10, 20, ni, ti);
+        world_set_contacts(&w, &prev, 1);
+        tmb_ws_store(&c, &w);
+
+        tmb_contact cur = make_contact(10, 20, 0.0f, 0.0f);
+        world_set_contacts(&w, &cur, 1);
+        tmb_ws_apply(&c, &w);
+
+        CHECK_NEAR(cur.normal_impulse,  ni, 1e-5f);
+        CHECK_NEAR(cur.tangent_impulse, ti, 1e-5f);
+    }
+
+    w.contacts = NULL; w.contact_count = 0;
+    tmb_world_free(&w);
+    tmb_ws_cache_free(&c);
+}
+
+/* Apply on an empty cache does nothing (no crash). */
+static void test_apply_empty_cache(void)
+{
+    tmb_ws_cache c;
+    tmb_ws_cache_init(&c);
+
+    tmb_world w;
+    tmb_world_init(&w);
+
+    tmb_contact cur = make_contact(0, 1, 5.0f, 2.0f);
+    world_set_contacts(&w, &cur, 1);
+    tmb_ws_apply(&c, &w);   /* must not crash */
+
+    /* Impulses unchanged since no prior store. */
+    CHECK_NEAR(cur.normal_impulse,  5.0f, 1e-5f);
+    CHECK_NEAR(cur.tangent_impulse, 2.0f, 1e-5f);
+
+    w.contacts = NULL; w.contact_count = 0;
+    tmb_world_free(&w);
+    tmb_ws_cache_free(&c);
+}
+
+/* ------------------------------------------------------------------ main */
+
+int main(void)
+{
+    test_basic_store_apply();
+    test_pair_symmetry();
+    test_two_point_manifold();
+    test_multiple_pairs();
+    test_pair_disappear_reappear();
+    test_multiple_steps();
+    test_apply_empty_cache();
+    TT_DONE();
+}
