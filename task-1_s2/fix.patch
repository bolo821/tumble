 }
 
@@ -125,13 +109,26 @@ void tmb_ws_apply(const tmb_ws_cache *c, tmb_world *w)
 {
     if (!c->table_cap)
         return;
+
+    /* Track how many contacts we have matched for each cached pair so that
+     * the first current contact gets ni[0]/ti[0], the second gets ni[1]/ti[1],
+     * matching the order in which tmb_ws_store recorded them. */
     for (size_t i = 0; i < w->contact_count; i++) {
         tmb_contact *cur = &w->contacts[i];
         uint64_t pair = ws_pack(cur->a, cur->b);
