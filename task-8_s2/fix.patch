+/* Remap joint body indices after a swap-pop: body `from` moved to slot `to`. */
+static void world_remap_joints(tmb_world *w, uint32_t from, uint32_t to)
+{
+    for (size_t k = 0; k < w->joint_count; k++) {
+        if (w->joints[k].a == from) w->joints[k].a = to;
+        if (w->joints[k].b == from) w->joints[k].b = to;
+    }
+}
+
+/* Remap xjoint body indices after a swap-pop: body `from` moved to slot `to`. */
+static void world_remap_xjoints(tmb_world *w, uint32_t from, uint32_t to)
+{
+    tmb_xjoint *xj = (tmb_xjoint *)w->xjoints;
+    for (size_t k = 0; k < w->xjoint_count; k++) {
+        if (xj[k].a == from) xj[k].a = to;
+        if (xj[k].b == from) xj[k].b = to;
+    }
+}
+
+/* Remap cached contact body indices after a swap-pop. */
+static void world_remap_contacts(tmb_world *w, uint32_t from, uint32_t to)
+{
+    for (size_t k = 0; k < w->contact_count; k++) {
+        if (w->contacts[k].a == from) w->contacts[k].a = to;
+        if (w->contacts[k].b == from) w->contacts[k].b = to;
+    }
+}
+
+void tmb_world_remove_joints_for_body(tmb_world *w, uint32_t body_idx)
+{
+    /* Remove regular joints referencing body_idx (swap-pop). */
+    size_t k = 0;
+    while (k < w->joint_count) {
+        if (w->joints[k].a == body_idx || w->joints[k].b == body_idx) {
+            w->joints[k] = w->joints[--w->joint_count];
+        } else {
+            k++;
+        }
+    }
+    /* Remove xjoints referencing body_idx (swap-pop). */
+    tmb_xjoint *xj = (tmb_xjoint *)w->xjoints;
+    k = 0;
+    while (k < w->xjoint_count) {
+        if (xj[k].a == body_idx || xj[k].b == body_idx) {
+            xj[k] = xj[--w->xjoint_count];
+        } else {
+            k++;
+        }
+    }
+}
+
+int tmb_world_body_valid(const tmb_world *w, uint32_t i)
+{
+    return i < w->body_count;
+}
